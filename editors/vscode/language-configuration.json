{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [],
  "autoClosingPairs": [{ "open": "\"", "close": "\"" }],
  "surroundingPairs": [{ "open": "\"", "close": "\"" }],
  "wordPattern": "(\\/[^\\s#\"]+)|([A-Za-z_][A-Za-z0-9_.+-]*)|(-?[0-9]+(?:\\.[0-9]+)?)",
  "indentationRules": {
    "increaseIndentPattern": "^(boundary|band)\\b.*$",
    "decreaseIndentPattern": "^(?!\\s).*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^(boundary|band)\\b.*$",
      "action": { "indent": "indent" }
    }
  ]
}
