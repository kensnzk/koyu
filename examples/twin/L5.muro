# L5 — ホテルエントランス・宴会・屋上庭園
#
# 基壇の屋上がこの建物の「地面」になる階。**セットバックで退いた分の屋根が
# すべて庭園になり**、二つの塔がそこから立ち上がる。ホテルの客は1階の専用ロビーから
# 客用EVで直接ここへ着く — 基壇の3層は通過する (ホールが無い)。
#
# 宴会場はA棟の足元。**宴会場の直上が機械階 (M1) になるのは半ば必然** — 天井裏に
# 途方もない量のダクトが要るからである。

# A棟の足元 — 宴会場
space /L5/ball room X4..X11 Y8+4200..Y10 name:大宴会場 lease.category:common
space /L5/bq room X4..X11 Y6..Y7 name:中宴会場 lease.category:common
space /L5/acorr5 corridor X3..X4 Y6..Y10 name:西サービス通路 lease.category:common
space /L5/foyer corridor X11..X13 Y6..Y10 name:ホワイエ lease.category:common floor:石張り
space /L5/pantry service X10..X11 Y7..Y8+4200 name:パントリー lease.category:common

# B棟の足元 — フロント・ラウンジ
space /L5/hfoy corridor X13..X19 Y7..Y7+2400 name:フロント前 lease.category:common floor:石張り
space /L5/lounge room X14..X17 Y6..Y7 name:ラウンジ lease.category:common
space /L5/recep service X17..X19 Y6..Y7 name:フロント・事務 lease.category:common
space /L5/cloak service X14..X15+5600 Y7+2400..Y8+4200 name:クローク・控室 lease.category:common
space /L5/prep service X18..X19 Y7+2400..Y8+4200 name:配膳準備 lease.category:common

# 屋上庭園 (緑化) — セットバックの屋根
space /L5/gdnS terrace X3..X19 Y5..Y6 name:南屋上庭園 lease.category:common floor:緑化
space /L5/gdnN terrace X13..X19 Y9..Y10 + X13..X14 Y7+2400..Y9 + X13..X14 Y6..Y7 name:北東屋上庭園 lease.category:common floor:緑化

boundary /L5/foyer /L5/ball t:180 spec:LGS
  door FD2 at:0.667 name:大宴会場
boundary /L5/foyer /L5/bq t:180 spec:LGS
  door FD2 name:中宴会場
boundary /L5/acorr5 /L5/ball t:180 spec:LGS
  door D1 at:0.667
boundary /L5/acorr5 /L5/bq t:180 spec:LGS
  door D1 at:0.3
boundary /L5/acorr5 /L5/ahall type:open
boundary /L5/pantry /L5/ball t:180 spec:LGS
  door D1 at:0.3 name:配膳口
boundary /L5/pantry /L5/foyer t:180 spec:LGS
  door D1 at:0.3
boundary /L5/foyer /L5/hfoy type:open
boundary /L5/hfoy /L5/lounge type:open
boundary /L5/hfoy /L5/recep t:120 spec:LGS
  door D1 at:0.3 name:フロント事務
boundary /L5/hfoy /L5/bhall2 type:open
boundary /L5/cloak /L5/hfoy t:120 spec:LGS
  door D1 at:0.3 name:クローク
boundary /L5/prep /L5/hfoy t:120 spec:LGS
  door D1 at:0.7 name:配膳
boundary /L5/foyer /L5/gdnS t:300 spec:カーテンウォール
  door AD2 at:0.25 name:南庭園へ
boundary /L5/foyer /L5/gdnN t:300 spec:カーテンウォール
boundary /L5/hfoy /L5/gdnN edge:N t:300 spec:カーテンウォール
  door AD2 at:0.3 name:北庭園へ
boundary /L5/lounge /L5/gdnS t:300 spec:カーテンウォール
  window CW2
boundary /L5/bq /L5/gdnS t:300 spec:カーテンウォール
  window CW2 at:0.3
  window CW2 at:0.7
boundary /L5/acorr5 /L5/gdnS t:300 spec:カーテンウォール

# 庭園の縁 — パラペット+手すり。air:1 なので半屋外に導出される
boundary /L5/gdnS /out edge:S t:120 spec:パラペット+手すり air:1 h:1200
boundary /L5/gdnS /out edge:W t:120 spec:パラペット+手すり air:1 h:1200
boundary /L5/gdnS /out edge:E t:120 spec:パラペット+手すり air:1 h:1200
boundary /L5/gdnN /out edge:N t:120 spec:パラペット+手すり air:1 h:1200
boundary /L5/gdnN /out edge:E t:120 spec:パラペット+手すり air:1 h:1200

# 外皮
boundary /L5/acorr5 /out edge:W t:250 spec:カーテンウォール
boundary /L5/acorr5 /out edge:N t:250 spec:カーテンウォール
boundary /L5/ball /out edge:N t:250 spec:カーテンウォール
  window CW2 at:0.25
  window CW2 at:0.75
boundary /L5/foyer /out edge:N t:250 spec:カーテンウォール
boundary /L5/recep /out edge:E t:250 spec:PC板
  window W2
boundary /L5/prep /out edge:E t:250 spec:PC板
boundary /L5/hfoy /out edge:E t:250 spec:PC板

# ---- M1 機械階 — 宴会場の直上。客の階数に現れない ----
space /M1/machA service X3..X11 Y6..Y7 + X3..X4 Y7..Y8+4200 + X10..X11 Y7..Y8+4200 + X3..X11 Y8+4200..Y10 name:A棟低層機械室 lease.category:common
space /M1/machB service X14..X19 Y6..Y7+2400 + X14..X15+5600 Y7+2400..Y8+4200 + X15+5600..X16 Y7+2400..Y7+5600 + X16..X17 Y7+2400..Y8+4200 + X17..X17+2800 Y7+2400..Y7+5600 + X17+2800..X19 Y7+2400..Y8+4200 name:B棟低層機械室 lease.category:common
boundary /M1/machA /M1/ahall type:open
boundary /M1/machB /M1/bst1 edge:W t:250 spec:RC
  door FD1 name:階段1から機械室
boundary /M1/machB /M1/bst2 edge:E t:250 spec:RC
  door FD1 name:階段2から機械室
boundary /M1/machA /out edge:S t:250 spec:ルーバー
boundary /M1/machA /out edge:N t:250 spec:ルーバー
boundary /M1/machA /out edge:W t:250 spec:ルーバー
boundary /M1/machA /out edge:E t:250 spec:ルーバー
boundary /M1/machB /out edge:S t:250 spec:ルーバー
boundary /M1/machB /out edge:W t:250 spec:ルーバー
boundary /M1/machB /out edge:E t:250 spec:ルーバー
