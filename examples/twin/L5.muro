# L5 ホテルエントランス・宴会 (階高6,900 / 天井6,000) と、その上の M2 機械階
#
# **ホテルの入口は5階にある。**基壇の商業を抜けた上に、独立したアプローチを作る。
# 客は1階の専用ロビーから基壇EV (pev) で5階へ上がり、ここでチェックインして、
# B棟の客用EV (bev) で客室階へ移る。**基壇EVは5階までしか無く、客用EVは5階からしか
# 無い** — 乗り換えが起きる階が、二つのシャフトの範囲の切れ目として現れる。
#
# 宴会場は1,000㎡級の一室で、天井裏に途方もない量のダクトが走る。
# **宴会場の上が機械階になるのは半ば必然である** — それが M2 の理由。
#
# ここから上は基壇が終わり、二つの塔だけになる。L5 は塔の footprint より広い最後の階。

space /L5/atrium void X11+3200..X14 Y3..Y17 + X11..X11+3200 Y3..Y7 + X11..X11+3200 Y7+13200..Y17 name:吹抜け
space /L5/es escalator X11..X11+3200 Y7..Y7+13200 name:エスカレーター use:common escalator:N
space /L5/galW corridor X10+4200..X11 Y3..Y17 name:西回廊 use:common floor:石張り
space /L5/galE corridor X14..X14+4200 Y3..Y17 name:東回廊 use:common floor:石張り

# 西 — レストラン街 (A棟の下)
space /L5/mallW corridor X3..X10+4200 Y8..Y8+4200 name:西通路 use:common floor:石張り
space /L5/mallW2 corridor X3..X10+4200 Y11..Y11+4200 name:西通路北 use:common floor:石張り
band X X3..X10+4200 Y3..Y8
  space /L5/r01 shop w:25200 name:レストラン01 use:rentable
  space /L5/r02 shop w:rest name:レストラン02 use:rentable
space /L5/r03 shop X3..X5 Y8+4200..Y11 name:レストラン03 use:rentable
space /L5/r04 shop X10..X10+4200 Y8+4200..Y11 name:レストラン04 use:rentable
band X X3..X10+4200 Y11+4200..Y17
  space /L5/r05 shop w:25200 name:レストラン05 use:rentable
  space /L5/r06 shop w:rest name:レストラン06 use:rentable

# 東 — ホテルのロビーと宴会場 (B棟の下)
# ロビーはコアを三方から包む — フロントもEVホールもここから見える
space /L5/lobby corridor X14+4200..X16 Y8..Y11 name:ホテルロビー use:common floor:石張り
space /L5/hcorr corridor X16..X18 Y8..Y8+4200 + X18..X19 Y8..Y11 name:ホテル通路 use:common floor:石張り
space /L5/foyer corridor X14+4200..X19 Y11..Y11+4200 name:宴会前室 use:common floor:石張り
space /L5/ball room X14+4200..X18 Y11+4200..Y17 name:大宴会場 use:common
space /L5/hback backyard X18..X19 Y11+4200..Y17 name:配膳室 use:common
space /L5/bank room X14+4200..X19 Y3..Y8 name:小宴会場・会議室 use:common

boundary /L5/galW /L5/mallW type:open
boundary /L5/galW /L5/mallW2 type:open
boundary /L5/galE /L5/lobby type:open
boundary /L5/mallW /L5/ahall type:open
boundary /L5/galW /L5/es type:open
boundary /L5/galW /L5/atrium t:60 spec:手すり air:1 h:1100
boundary /L5/galE /L5/atrium t:60 spec:手すり air:1 h:1100

boundary /L5/r01 /L5/mallW t:120 spec:店舗サッシ
  door SD1
boundary /L5/r02 /L5/mallW t:120 spec:店舗サッシ
  door SD1
boundary /L5/r03 /L5/mallW t:120 spec:店舗サッシ
  door SD1
boundary /L5/r04 /L5/mallW t:120 spec:店舗サッシ
  door SD1
boundary /L5/r05 /L5/mallW2 t:120 spec:店舗サッシ
  door SD1
boundary /L5/r06 /L5/mallW2 t:120 spec:店舗サッシ
  door SD1
boundary /L5/lobby /L5/bank t:180 spec:LGS
  door FD2 name:小宴会場へ
boundary /L5/lobby /L5/hcorr type:open
boundary /L5/hcorr /L5/bhall type:open
boundary /L5/lobby /L5/foyer t:180 spec:LGS
  door FD2 name:宴会前室へ
boundary /L5/foyer /L5/ball t:180 spec:LGS
  door FD2 name:大宴会場へ
boundary /L5/foyer /L5/hback t:180 spec:LGS
  door D1 name:配膳室へ
boundary /L5/hback /L5/ball t:180 spec:LGS
  door D1 name:配膳口

# 外皮
boundary /L5/r01 /out edge:S t:300 spec:カーテンウォール
  window CW1
boundary /L5/r02 /out edge:S t:300 spec:カーテンウォール
  window CW1
boundary /L5/r01 /out edge:W t:300 spec:カーテンウォール
  window CW1
boundary /L5/r03 /out edge:W t:300 spec:カーテンウォール
  window CW1
boundary /L5/r05 /out edge:W t:300 spec:カーテンウォール
  window CW1
boundary /L5/r05 /out edge:N t:300 spec:カーテンウォール
  window CW1
boundary /L5/r06 /out edge:N t:300 spec:カーテンウォール
  window CW1
boundary /L5/mallW /out edge:W t:300 spec:カーテンウォール
boundary /L5/mallW2 /out edge:W t:300 spec:カーテンウォール
boundary /L5/bank /out edge:S t:300 spec:カーテンウォール
  window CW1
boundary /L5/bank /out edge:E t:300 spec:カーテンウォール
  window CW1
boundary /L5/hcorr /out edge:E t:300 spec:カーテンウォール
  window CW1
boundary /L5/hback /out edge:E t:300 spec:RC
boundary /L5/hback /out edge:N t:300 spec:RC
boundary /L5/foyer /out edge:E t:300 spec:カーテンウォール
boundary /L5/ball /out edge:N t:300 spec:カーテンウォール
  window CW1
boundary /L5/atrium /out edge:S t:300 spec:カーテンウォール
boundary /L5/atrium /out edge:N t:300 spec:カーテンウォール
boundary /L5/galW /out edge:S t:300 spec:カーテンウォール
boundary /L5/galW /out edge:N t:300 spec:カーテンウォール
boundary /L5/galE /out edge:S t:300 spec:カーテンウォール
boundary /L5/galE /out edge:N t:300 spec:カーテンウォール

# ---- M2 機械階 — 宴会場の直上。ここも客の階数に現れない ----
space /M2/ahuW service X3..X10+4200 Y3..Y8+4200 + X3..X5 Y8+4200..Y11 + X10..X10+4200 Y8+4200..Y11 + X3..X10+4200 Y11..Y17 name:空調機械室西 use:common
space /M2/ahuE service X14+4200..X19 Y3..Y8+4200 + X14+4200..X16 Y8+4200..Y11 + X18..X19 Y8+4200..Y11 + X14+4200..X19 Y11..Y17 name:空調機械室東 use:common
space /M2/roofW terrace X10+4200..X11 Y3..Y17 name:西側屋上 use:common
space /M2/roofE terrace X14..X14+4200 Y3..Y17 name:東側屋上 use:common
space /M2/atrium void X11..X14 Y3..Y17 name:吹抜け上部

boundary /M2/ahuW /M2/ahall type:open
boundary /M2/ahuE /M2/bhall type:open
boundary /M2/ahuW /M2/roofW t:300 spec:RC
  door FD1 name:屋上点検口
boundary /M2/ahuE /M2/roofE t:300 spec:RC
  door FD1 name:屋上点検口
boundary /M2/roofW /M2/atrium t:60 spec:手すり air:1 h:1100
boundary /M2/roofE /M2/atrium t:60 spec:手すり air:1 h:1100
boundary /M2/ahuW /out edge:W t:300 spec:ルーバー
boundary /M2/ahuW /out edge:S t:300 spec:ルーバー
boundary /M2/ahuW /out edge:N t:300 spec:ルーバー
boundary /M2/ahuE /out edge:E t:300 spec:ルーバー
boundary /M2/ahuE /out edge:S t:300 spec:ルーバー
boundary /M2/ahuE /out edge:N t:300 spec:ルーバー
boundary /M2/roofW /out edge:S t:120 spec:パラペット air:1 h:1200
boundary /M2/roofW /out edge:N t:120 spec:パラペット air:1 h:1200
boundary /M2/roofE /out edge:S t:120 spec:パラペット air:1 h:1200
boundary /M2/roofE /out edge:N t:120 spec:パラペット air:1 h:1200
boundary /M2/atrium /out edge:S t:300 spec:トップライト air:1 h:1200
boundary /M2/atrium /out edge:N t:300 spec:トップライト air:1 h:1200
