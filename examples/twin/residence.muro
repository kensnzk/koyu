# B棟 レジデンス L13〜L18 — 同じ板の上で用途が変わる
#
# ホテルと同じ板・同じコア・同じ階高に、住戸が載る。変わるのは割りと**採光の宣言**。
# 共同住宅の居室は令19条の列挙にあるので daylight:1 — 同じ窓でも判断が変わる (ADR-0020)。
# 南列5戸 (8.4m) + 北東1戸 + 西はビューラウンジ = 6戸/階 × 6層 = **36戸**。
#
# 屋上 (L19の高さ) は住民の庭園 — B棟の頭が緑になる。

space /L13..L18/rcorr corridor X14..X19 Y7..Y7+2400 name:住戸廊下 use:common
band X X14..X19 Y6..Y7
  space /L13..L18/rs01 unit w:8400 name:住戸S01 use:exclusive daylight:1
  space /L13..L18/rs02 unit w:8400 name:住戸S02 use:exclusive daylight:1
  space /L13..L18/rs03 unit w:8400 name:住戸S03 use:exclusive daylight:1
  space /L13..L18/rs04 unit w:8400 name:住戸S04 use:exclusive daylight:1
  space /L13..L18/rs05 unit w:rest name:住戸S05 use:exclusive daylight:1
# 西向きの奥行10.2mは1住戸の窓では 1/7 に届かない — 住戸にせず共用のビューラウンジにする
space /L13..L18/rlounge room X14..X15+5600 Y7+2400..Y8+4200 name:ビューラウンジ use:common
space /L13..L18/rn02 unit X18..X19 Y7+2400..Y8+4200 name:住戸N02 use:exclusive daylight:1

boundary /L13..L18/rcorr /L13..L18/bhall2 type:open
boundary /L13..L18/rcorr /L13..L18/bslob t:180 spec:LGS
  door D1 at:0.85 name:サービス前室
boundary /L13..L18/rs01 /L13..L18/rcorr t:180 spec:戸境RC
  door D2 name:玄関
boundary /L13..L18/rs02 /L13..L18/rcorr t:180 spec:戸境RC
  door D2 at:0.3 name:玄関
boundary /L13..L18/rs03 /L13..L18/rcorr t:180 spec:戸境RC
  door D2 name:玄関
boundary /L13..L18/rs04 /L13..L18/rcorr t:180 spec:戸境RC
  door D2 at:0.3 name:玄関
boundary /L13..L18/rs05 /L13..L18/rcorr t:180 spec:戸境RC
  door D2 name:玄関
boundary /L13..L18/rlounge /L13..L18/rcorr t:180 spec:LGS
  door AD2 at:0.3 name:ラウンジ
boundary /L13..L18/rn02 /L13..L18/rcorr t:180 spec:戸境RC
  door D2 at:0.3 name:玄関

# 外皮 — 掃き出しは引違い部 (door) と FIX部 (window) に分けて書く。
# 窓しか無い住戸には出入りできない、が導出の答えになる
boundary /L13..L18/rs01 /out edge:S t:250 spec:PC板
  window RW1
boundary /L13..L18/rs02 /out edge:S t:250 spec:PC板
  window RW1
boundary /L13..L18/rs03 /out edge:S t:250 spec:PC板
  window RW1
boundary /L13..L18/rs04 /out edge:S t:250 spec:PC板
  window RW1
boundary /L13..L18/rs05 /out edge:S t:250 spec:PC板
  window RW1
boundary /L13..L18/rs01 /out edge:W t:250 spec:PC板
boundary /L13..L18/rs05 /out edge:E t:250 spec:PC板
boundary /L13..L18/rlounge /out edge:W t:250 spec:PC板
  window RW1
boundary /L13..L18/rn02 /out edge:E t:250 spec:PC板
  window RW1
boundary /L13..L18/rcorr /out edge:W t:250 spec:PC板
  window W2
boundary /L13..L18/rcorr /out edge:E t:250 spec:PC板
  window W2

# ---- B棟屋上庭園 (L19の高さ) ----
space /L19/broof terrace X14..X19 Y6..Y9 name:B棟屋上庭園 use:common floor:緑化
boundary /L18/bst1 /L19/broof type:stair
boundary /L19/broof /out edge:S t:120 spec:パラペット+手すり air:1 h:1200
boundary /L19/broof /out edge:N t:120 spec:パラペット+手すり air:1 h:1200
boundary /L19/broof /out edge:W t:120 spec:パラペット+手すり air:1 h:1200
boundary /L19/broof /out edge:E t:120 spec:パラペット+手すり air:1 h:1200
