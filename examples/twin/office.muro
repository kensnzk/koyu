# A棟 オフィス L6〜L34 — 基準階を二度だけ書く
#
# 板 2,258㎡ (67.2m × 33.6m)。**コアからの張り出しは 8.4〜12.6m** — 貸室として
# 標準のデプスで、構造の持ち出しでもない。コア帯 635㎡ (28%) はスリムな塔の正直な代償。
#
# **南西の隅は斜めに落とす。**基壇の隅切りと同じ向きの線が、塔にも一本だけ通る。

space /L6..L20/aoff1 room X3..X11 Y6..Y7 name:貸室南 use:rentable
space /L6..L20/aoff2 room X3..X11 Y8+4200..Y10 name:貸室北 use:rentable
space /L6..L20/aoffW room X3..X4 Y7..Y8+4200 name:貸室西 use:rentable
space /L6..L20/aoffE room X10..X11 Y7..Y8+4200 name:貸室東 use:rentable
space /L21..L34/aoff1 room X3..X11 Y6..Y7 name:貸室南 use:rentable
space /L21..L34/aoff2 room X3..X11 Y8+4200..Y10 name:貸室北 use:rentable
space /L21..L34/aoffW room X3..X4 Y7..Y8+4200 name:貸室西 use:rentable
space /L21..L34/aoffE room X10..X11 Y7..Y8+4200 name:貸室東 use:rentable

boundary /L6..L20/aoffW /L6..L20/ahall t:120 spec:スチールパーティション
  door FD2 name:貸室入口西
boundary /L6..L20/aoffE /L6..L20/ahall t:120 spec:スチールパーティション
  door FD2 name:貸室入口東
boundary /L6..L20/aoff1 /L6..L20/aoffW t:120 spec:スチールパーティション
  door D1 at:0.3
boundary /L6..L20/aoff1 /L6..L20/aoffE t:120 spec:スチールパーティション
  door D1 at:0.3
boundary /L6..L20/aoff2 /L6..L20/aoffW t:120 spec:スチールパーティション
  door D1 at:0.3
boundary /L6..L20/aoff2 /L6..L20/aoffE t:120 spec:スチールパーティション
  door D1 at:0.3
boundary /L21..L34/aoffW /L21..L34/ahall t:120 spec:スチールパーティション
  door FD2 name:貸室入口西
boundary /L21..L34/aoffE /L21..L34/ahall t:120 spec:スチールパーティション
  door FD2 name:貸室入口東
boundary /L21..L34/aoff1 /L21..L34/aoffW t:120 spec:スチールパーティション
  door D1 at:0.3
boundary /L21..L34/aoff1 /L21..L34/aoffE t:120 spec:スチールパーティション
  door D1 at:0.3
boundary /L21..L34/aoff2 /L21..L34/aoffW t:120 spec:スチールパーティション
  door D1 at:0.3
boundary /L21..L34/aoff2 /L21..L34/aoffE t:120 spec:スチールパーティション
  door D1 at:0.3

# 外皮 — 全周カーテンウォール。南西の隅だけ斜め
boundary /L6..L20/aoff1 /out edge:S t:250 spec:カーテンウォール
  window CW2 at:0.14
  window CW2 at:0.38
  window CW2 at:0.62
  window CW2 at:0.86
boundary /L6..L20/aoff1 /out t:250 spec:カーテンウォール
  line X3+4200,Y6 X3,Y6+4200
boundary /L6..L20/aoff1 /out edge:E t:250 spec:カーテンウォール
boundary /L6..L20/aoff2 /out edge:N t:250 spec:カーテンウォール
  window CW2 at:0.14
  window CW2 at:0.38
  window CW2 at:0.62
  window CW2 at:0.86
boundary /L6..L20/aoff2 /out edge:W t:250 spec:カーテンウォール
boundary /L6..L20/aoff2 /out edge:E t:250 spec:カーテンウォール
boundary /L6..L20/aoffW /out edge:W t:250 spec:カーテンウォール
  window CW2
boundary /L6..L20/aoffE /out edge:E t:250 spec:カーテンウォール
  window CW2
boundary /L21..L34/aoff1 /out edge:S t:250 spec:カーテンウォール
  window CW2 at:0.14
  window CW2 at:0.38
  window CW2 at:0.62
  window CW2 at:0.86
boundary /L21..L34/aoff1 /out t:250 spec:カーテンウォール
  line X3+4200,Y6 X3,Y6+4200
boundary /L21..L34/aoff1 /out edge:E t:250 spec:カーテンウォール
boundary /L21..L34/aoff2 /out edge:N t:250 spec:カーテンウォール
  window CW2 at:0.14
  window CW2 at:0.38
  window CW2 at:0.62
  window CW2 at:0.86
boundary /L21..L34/aoff2 /out edge:W t:250 spec:カーテンウォール
boundary /L21..L34/aoff2 /out edge:E t:250 spec:カーテンウォール
boundary /L21..L34/aoffW /out edge:W t:250 spec:カーテンウォール
  window CW2
boundary /L21..L34/aoffE /out edge:E t:250 spec:カーテンウォール
  window CW2
boundary /L6..L20/aoff1 /out edge:W t:250 spec:カーテンウォール
boundary /L21..L34/aoff1 /out edge:W t:250 spec:カーテンウォール

# ---- M2 中間機械階 — 客の階数に現れない ----
space /M2/amach service X3..X11 Y6..Y7 + X3..X4 Y7..Y8+4200 + X10..X11 Y7..Y8+4200 + X3..X11 Y8+4200..Y10 name:中間機械室 use:common
boundary /M2/amach /M2/ahall type:open
boundary /M2/amach /out edge:S t:250 spec:ルーバー
boundary /M2/amach /out edge:N t:250 spec:ルーバー
boundary /M2/amach /out edge:W t:250 spec:ルーバー
boundary /M2/amach /out edge:E t:250 spec:ルーバー

# ---- R1 塔屋 ----
space /R1/ptop service X3..X11 Y6..Y7 + X3..X4 Y7..Y8+4200 + X10..X11 Y7..Y8+4200 + X3..X11 Y8+4200..Y10 name:塔屋・冷却塔 use:common
boundary /R1/ptop /R1/ahall type:open
boundary /R1/ptop /out edge:S t:250 spec:ルーバー
boundary /R1/ptop /out edge:N t:250 spec:ルーバー
boundary /R1/ptop /out edge:W t:250 spec:ルーバー
boundary /R1/ptop /out edge:E t:250 spec:ルーバー
