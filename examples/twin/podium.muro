  window CW1
boundary /L2..L4/mallE /out edge:E t:300 spec:カーテンウォール
boundary /L2..L4/mallE2 /out edge:E t:300 spec:カーテンウォール
boundary /L2..L4/atrium /out edge:S t:300 spec:カーテンウォール
boundary /L2..L4/atrium /out edge:N t:300 spec:カーテンウォール
