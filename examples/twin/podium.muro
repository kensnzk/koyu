# 基壇 L2〜L4 — 物販・飲食。**段々にセットバックし、退いた分の屋根がテラス緑化になる**
#
#   L2  X2..X19 × Y4..Y12 (L1と同じ外形。四隅の斜めも同じ線)
#   L3  X3..X19 × Y4..Y11 — 西と北を1スパン退き、その屋根がテラス
#   L4  X3..X19 × Y5..Y10 — 南と北をさらに退く。飲食の階
#
# 吹抜けは貫通アトリウムの上に開き、回廊が一周する。エスカレーターは吹抜けの中。
# 縁は手すり (air:1) — 床の無い所に扉は開かない。

# ---- 吹抜けとエスカレーター (L2〜L4 で共有) ----
space /L2/avoid X12+3200..X13 Y5..Y11 + X12..X12+3200 Y5..Y6+5600 + X12..X12+3200 Y8+3600..Y11 name:吹抜け void:1
space /L3/avoid X12+3200..X13 Y5..Y11 + X12..X12+3200 Y5..Y7 + X12..X12+3200 Y8+3600..Y11 name:吹抜け void:1
# L4 の吹抜けは基壇のセットバックに合わせて短い — 段々は吹抜けにも及ぶ
space /L4/avoid X12+3200..X13 Y6..Y10 + X12..X12+3200 Y6..Y7 + X12..X12+3200 Y8+3600..Y10 name:吹抜け void:1
space /L2..L4/es2 escalator X12..X12+3200 Y7..Y7+12000 name:エスカレーター lease.category:common escalator:N
space /L2/es1 corridor X12..X12+3200 Y6+5600..Y7 name:エスカレーター乗降 lease.category:common
boundary /L1/atrium /L2/avoid type:void
boundary /L2/avoid /L3/avoid type:void
boundary /L3/avoid /L4/avoid type:void
boundary /L2/es1 /L2/es2 type:open

# ---- L2 — L1と同じ外形 ----
space /L2/gal corridor X11..X12 Y4..Y12 + X13..X14 Y4..Y12 + X12..X13 Y4..Y5 + X12..X13 Y11..Y12 name:回廊 lease.category:common floor:石張り
boundary /L2/gal /L2/avoid t:60 spec:手すり air:1 h:1100
boundary /L2/gal /L2/es2 type:open
band X X2..X11 Y4..Y5
  space /L2/s01 shop w:25200 name:南区画01 lease.category:rentable
  space /L2/s02 shop w:rest name:南区画02 lease.category:rentable
space /L2/s04 shop X14..X19 Y4..Y5 name:南区画03 lease.category:rentable
space /L2/mallSw corridor X2..X11 Y5..Y6 name:南モール西 lease.category:common floor:石張り
space /L2/mallSe corridor X14..X19 Y5..Y6 name:南モール東 lease.category:common floor:石張り
# 西の1スパン (X2..X3) はエントランス吹抜け — 1階の大開口の上をガラスが2層で立つ
space /L2/alvoid X2..X3 Y7..Y9 name:エントランス吹抜け void:1
space /L2/es4 corridor X2..X3 Y6..Y7 name:下りエスカレーター乗り場 lease.category:common
space /L2/es3 corridor X2..X3 Y9..Y10 name:上りエスカレーター降り場 lease.category:common
