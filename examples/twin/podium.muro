  window CW1
boundary /L2..L4/w06 /out edge:W t:300 spec:カーテンウォール
  window CW1
boundary /L2..L4/w06 /out edge:N t:300 spec:カーテンウォール
  window CW1
boundary /L2..L4/w07 /out edge:N t:300 spec:カーテンウォール
  window CW1
boundary /L2..L4/w08 /out edge:N t:300 spec:カーテンウォール
  window CW1
boundary /L2..L4/mallW /out edge:W t:300 spec:カーテンウォール
boundary /L2..L4/mallW2 /out edge:W t:300 spec:カーテンウォール
boundary /L2..L4/e01 /out edge:S t:300 spec:カーテンウォール
  window CW1
