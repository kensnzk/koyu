boundary /L6..L13/hs01 /out edge:W t:250 spec:PC板
boundary /L6..L13/hs07 /out edge:E t:250 spec:PC板
boundary /L6..L13/hn01 /out edge:W t:250 spec:PC板
boundary /L6..L13/hn07 /out edge:E t:250 spec:PC板
