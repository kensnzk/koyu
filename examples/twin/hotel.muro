# B棟 ホテル L6〜L12 — 客室は実寸で割る
#
# 客室 幅4.2m × 奥行8.4m ≈ 35㎡ (バス込み)。南列10室 + 北西3室 + 北東1室 = 14室/階。
# 7層 × 14室 = **98室** — 客用EV3台 (98室 ÷ 100室/台 ≈ 1台+予備) に対して現実的。
#
# **客室に daylight:1 は書かない。**採光 (法28条) の対象は令19条の列挙で決まり、
# 旅館・ホテルは無い。同じ板の上のレジデンス (L13〜) には書く — 判断は用途で変わる。

space /L6..L12/corr corridor X14..X19 Y7..Y7+2400 name:客室廊下 lease.category:common
band X X14..X19 Y6..Y7
  space /L6..L12/hs01 room w:4200 name:客室S01 lease.category:rentable daylight:0
  space /L6..L12/hs02 room w:4200 name:客室S02 lease.category:rentable daylight:0
  space /L6..L12/hs03 room w:4200 name:客室S03 lease.category:rentable daylight:0
  space /L6..L12/hs04 room w:4200 name:客室S04 lease.category:rentable daylight:0
  space /L6..L12/hs05 room w:4200 name:客室S05 lease.category:rentable daylight:0
  space /L6..L12/hs06 room w:4200 name:客室S06 lease.category:rentable daylight:0
  space /L6..L12/hs07 room w:4200 name:客室S07 lease.category:rentable daylight:0
  space /L6..L12/hs08 room w:4200 name:客室S08 lease.category:rentable daylight:0
  space /L6..L12/hs09 room w:4200 name:客室S09 lease.category:rentable daylight:0
  space /L6..L12/hs10 room w:rest name:客室S10 lease.category:rentable daylight:0
space /L6..L12/hn01 room X14..X14+4700 Y7+2400..Y8+4200 name:客室N01 lease.category:rentable daylight:0
space /L6..L12/hn02 room X14+4700..X15+900 Y7+2400..Y8+4200 name:客室N02 lease.category:rentable daylight:0
space /L6..L12/hn03 room X15+900..X15+5600 Y7+2400..Y8+4200 name:客室N03 lease.category:rentable daylight:0
space /L6..L12/hn04 room X18..X19 Y7+2400..Y8+4200 name:客室N04スイート lease.category:rentable daylight:0

boundary /L6..L12/corr /L6..L12/bhall2 type:open
boundary /L6..L12/corr /L6..L12/bslob t:180 spec:LGS
  door D1 at:0.85 name:サービス前室
boundary /L6..L12/hs01 /L6..L12/corr t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L12/hs02 /L6..L12/corr t:180 spec:戸境RC
  door D2 at:0.3 name:客室扉
