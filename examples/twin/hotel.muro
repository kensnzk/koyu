# B棟 ホテル L6〜L13 — 客室は帯 (band) で割る
#
# 板 2,470㎡ / コア 353㎡ / 中廊下 353㎡ / 客室部 1,764㎡。
# 8層 × 17室 = 136室。**17行の帯の宣言から136室が展開される。**
#
# **客室に daylight:1 は書かない。**採光 (法28条) の対象となる居室は令19条が列挙していて、
# 住宅・学校・病院・診療所・寄宿舎・下宿はそこにあるが、旅館・ホテルの客室は無い。
# 窓の大きさの話ではなく、この室に 1/7 の規則が掛かるかどうかの判断である。
# **同じ板の上の階 (L14〜L20) はレジデンスなので、そちらは対象になる** — 判断が
# 型ではなく用途で決まることが、この一棟の中で二度現れる (ADR-0020)。

# 廊下はコアを一周する環である。**環でないと北側の客室が行き止まりになる** —
# 避難は二方向に取れなければならない
space /L6..L13/hcorrS corridor X14..X19 Y8..Y8+4200 name:客室廊下南 use:common
space /L6..L13/hcorrN corridor X14..X19 Y11..Y11+4200 name:客室廊下北 use:common
space /L6..L13/hcorrW corridor X16-4200..X16 Y8+4200..Y11 name:客室廊下西 use:common
space /L6..L13/hcorrE corridor X18..X19 Y8+4200..Y11 name:客室廊下東 use:common

band X X14..X19 Y6..Y8
  space /L6..L13/hs01 room w:5600 name:客室S01 use:rentable daylight:0
  space /L6..L13/hs02 room w:5600 name:客室S02 use:rentable daylight:0
  space /L6..L13/hs03 room w:5600 name:客室S03 use:rentable daylight:0
  space /L6..L13/hs04 room w:5600 name:客室S04 use:rentable daylight:0
  space /L6..L13/hs05 room w:5600 name:客室S05 use:rentable daylight:0
  space /L6..L13/hs06 room w:5600 name:客室S06 use:rentable daylight:0
  space /L6..L13/hs07 room w:rest name:客室S07 use:rentable daylight:0

band X X14..X19 Y11+4200..Y13
  space /L6..L13/hn01 room w:5600 name:客室N01 use:rentable daylight:0
  space /L6..L13/hn02 room w:5600 name:客室N02 use:rentable daylight:0
  space /L6..L13/hn03 room w:5600 name:客室N03 use:rentable daylight:0
  space /L6..L13/hn04 room w:5600 name:客室N04 use:rentable daylight:0
  space /L6..L13/hn05 room w:5600 name:客室N05 use:rentable daylight:0
  space /L6..L13/hn06 room w:5600 name:客室N06 use:rentable daylight:0
  space /L6..L13/hn07 room w:rest name:客室N07 use:rentable daylight:0

band Y X14..X16-4200 Y8+4200..Y11
  space /L6..L13/hw01 room w:7000 name:客室W01 use:rentable daylight:0
  space /L6..L13/hw02 room w:7000 name:客室W02 use:rentable daylight:0
  space /L6..L13/hw03 room w:rest name:客室W03 use:rentable daylight:0

# ---- 廊下とコア ----
boundary /L6..L13/hcorrS /L6..L13/bhall type:open
boundary /L6..L13/hcorrS /L6..L13/hcorrW type:open
boundary /L6..L13/hcorrS /L6..L13/hcorrE type:open
boundary /L6..L13/hcorrN /L6..L13/hcorrW type:open
boundary /L6..L13/hcorrN /L6..L13/hcorrE type:open
boundary /L6..L13/hcorrE /L6..L13/bhall type:open

# 客室は廊下から入る
boundary /L6..L13/hs01 /L6..L13/hcorrS t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hs02 /L6..L13/hcorrS t:180 spec:戸境RC
  door D2 at:0.28 name:客室扉
boundary /L6..L13/hs03 /L6..L13/hcorrS t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hs04 /L6..L13/hcorrS t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hs05 /L6..L13/hcorrS t:180 spec:戸境RC
  door D2 at:0.28 name:客室扉
boundary /L6..L13/hs06 /L6..L13/hcorrS t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hs07 /L6..L13/hcorrS t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hn01 /L6..L13/hcorrN t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hn02 /L6..L13/hcorrN t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hn03 /L6..L13/hcorrN t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hn04 /L6..L13/hcorrN t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hn05 /L6..L13/hcorrN t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hn06 /L6..L13/hcorrN t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hn07 /L6..L13/hcorrN t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hw01 /L6..L13/hcorrW t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hw03 /L6..L13/hcorrW t:180 spec:戸境RC
  door D2 name:客室扉
boundary /L6..L13/hw02 /L6..L13/hcorrW t:180 spec:戸境RC
  door D2 name:客室扉

# ---- 外皮 ----
boundary /L6..L13/hs01 /out edge:S t:250 spec:PC板
  window HW1
boundary /L6..L13/hs02 /out edge:S t:250 spec:PC板
  window HW1
boundary /L6..L13/hs03 /out edge:S t:250 spec:PC板
  window HW1
boundary /L6..L13/hs04 /out edge:S t:250 spec:PC板
  window HW1
boundary /L6..L13/hs05 /out edge:S t:250 spec:PC板
  window HW1
boundary /L6..L13/hs06 /out edge:S t:250 spec:PC板
  window HW1
boundary /L6..L13/hs07 /out edge:S t:250 spec:PC板
  window HW1
boundary /L6..L13/hn01 /out edge:N t:250 spec:PC板
  window HW1
boundary /L6..L13/hn02 /out edge:N t:250 spec:PC板
  window HW1
boundary /L6..L13/hn03 /out edge:N t:250 spec:PC板
  window HW1
