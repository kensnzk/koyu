boundary /B2..R1/ahall /B2..R1/aevHn3 t:250 spec:RC
boundary /B2..R1/ahall /B2..R1/afr1 t:250 spec:RC
  door FD1 at:0.3 name:荷物用EV戸1
boundary /B2..R1/ahall /B2..R1/afr2 t:250 spec:RC
  door FD1 at:0.3 name:荷物用EV戸2
boundary /B2..R1/ahall /B2..R1/awcm t:180 spec:LGS
  door D1 at:0.35 name:男子便所
boundary /B2..R1/ahall /B2..R1/awcw t:180 spec:LGS
  door D1 at:0.35 name:女子便所
boundary /B2..R1/ahall /B2..R1/autl t:180 spec:LGS
