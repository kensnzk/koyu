# 高層 14〜19階 — ホテル。客室は帯 (band) で割る。
#
# 帯は「位置ではなく寸法と並びを書き、位置を導く」記法 (ADR-0019)。客室の割付はまさに
# これで、8室の幅を並べれば通り芯からの位置は計算される。閉じた帯なので合計が帯幅と
# 一致することを parse が照合する — 寸法の打ち間違いの検算になる。
# 6層 × 13室 = 78室が、13行の帯の宣言から展開される。
#
# 客室には daylight:1 を書く。ここは 1/7 を掛けたい室である。

space /L14..L19/corridor corridor X2..X8 Y2+9000..Y4-3200 name:客室廊下 use:common

band X X2..X8 Y2..Y2+9000
  space /L14..L19/r01 room w:6000 name:客室01 use:rentable daylight:1
  space /L14..L19/r02 room w:6000 name:客室02 use:rentable daylight:1
  space /L14..L19/r03 room w:6000 name:客室03 use:rentable daylight:1
  space /L14..L19/r04 room w:6000 name:客室04 use:rentable daylight:1
  space /L14..L19/r05 room w:6000 name:客室05 use:rentable daylight:1
  space /L14..L19/r06 room w:6000 name:客室06 use:rentable daylight:1
  space /L14..L19/r07 room w:6000 name:客室07 use:rentable daylight:1
  space /L14..L19/r08 room w:rest name:客室08 use:rentable daylight:1

band X X2..X4 Y4-3200..Y5
  space /L14..L19/s01 room w:5000 name:スイート01 use:rentable daylight:1
  space /L14..L19/s02 room w:5000 name:スイート02 use:rentable daylight:1
  space /L14..L19/s03 room w:rest name:スイート03 use:rentable daylight:1

band X X7..X8 Y4-3200..Y5
  space /L14..L19/s04 room w:4000 name:スイート04 use:rentable daylight:1
  space /L14..L19/s05 room w:rest name:スイート05 use:rentable daylight:1

# ---- 客室と廊下 ----
boundary /L14..L19/r01 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/r02 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/r03 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/r04 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/r05 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/r06 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/r07 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/r08 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/s01 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/s02 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/s03 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/s04 /L14..L19/corridor t:180 spec:戸境RC
  door HD1
boundary /L14..L19/s05 /L14..L19/corridor t:180 spec:戸境RC
  door HD1

# ---- コア ----
boundary /L14..L19/corridor /L14..L19/hall type:open
boundary /L14..L19/s03 /L14..L19/ps t:250 spec:RC
boundary /L14..L19/s04 /L14..L19/st2 t:250 spec:RC

# ---- 外周 ----
boundary /L14..L19/r01 /out edge:S t:250 spec:PC板
  window W1
boundary /L14..L19/r02 /out edge:S t:250 spec:PC板
  window W1
boundary /L14..L19/r03 /out edge:S t:250 spec:PC板
  window W1
boundary /L14..L19/r04 /out edge:S t:250 spec:PC板
  window W1
boundary /L14..L19/r05 /out edge:S t:250 spec:PC板
  window W1
boundary /L14..L19/r06 /out edge:S t:250 spec:PC板
  window W1
boundary /L14..L19/r07 /out edge:S t:250 spec:PC板
  window W1
boundary /L14..L19/r08 /out edge:S t:250 spec:PC板
  window W1
boundary /L14..L19/r01 /out edge:W t:250 spec:PC板
  window W2
boundary /L14..L19/r08 /out edge:E t:250 spec:PC板
  window W2
boundary /L14..L19/corridor /out edge:W t:250 spec:PC板
  window W2
boundary /L14..L19/corridor /out edge:E t:250 spec:PC板
  window W2
boundary /L14..L19/s01 /out edge:N t:250 spec:PC板
  window W1
boundary /L14..L19/s02 /out edge:N t:250 spec:PC板
  window W1
boundary /L14..L19/s03 /out edge:N t:250 spec:PC板
  window W1
boundary /L14..L19/s04 /out edge:N t:250 spec:PC板
  window W1
boundary /L14..L19/s05 /out edge:N t:250 spec:PC板
  window W1
boundary /L14..L19/s01 /out edge:W t:250 spec:PC板
  window W1
boundary /L14..L19/s05 /out edge:E t:250 spec:PC板
  window W1
boundary /L14..L19/ps /out edge:N t:250 spec:PC板
boundary /L14..L19/tea /out edge:N t:250 spec:PC板
boundary /L14..L19/st1 /out edge:N t:250 spec:PC板
boundary /L14..L19/ev1 /out edge:N t:250 spec:PC板
boundary /L14..L19/ev2 /out edge:N t:250 spec:PC板
boundary /L14..L19/wcm /out edge:N t:250 spec:PC板
boundary /L14..L19/wcw /out edge:N t:250 spec:PC板
boundary /L14..L19/st2 /out edge:N t:250 spec:PC板
