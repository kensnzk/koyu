# 基壇 2〜5階 — 商業。テナント区画・モール・吹抜けが割り付けられる。
#
# **テナント区画は帯 (band) が割る。**寸法と並びを書けば通り芯からの位置は導かれる
# (ADR-0019)。同じ12行が4層に展開され、48区画になる。区画の割り直しは幅の数字を
# 書き換えるだけで、隣の区画の位置は自動的に動く — これが「位置ではなく寸法を書く」
# ことの効き目である。
#
# 斜めは1階の貫通通路にだけある。吹抜けは矩形である — 斜めは動線の決定から来た線で
# あって、上階まで引きずる理由が無い。線を引く数は設計判断の数と一致すべきで、
# 「一度斜めにしたから上まで斜め」は判断ではなく惰性である (ADR-0022 の線の経済)。
# 外形の隅切りだけは所与の線 (隣地境界) に従うので基壇の全層に現れる。

# 吹抜けは**床の不在**である。区画の扉を吹抜けに開くと、そこは床の無い所なので出られない。
# 西列の区画は回廊に面させ、回廊がモールへ回り込む — 吹抜けの縁は手すりになる
space /L2..L5/wgal corridor X2..X2+2400 Y1..Y6 + X2+2400..X3 Y2..Y2+3600 name:西回廊 lease.category:common floor:石張り
space /L2..L5/atrium X2+2400..X3 Y1..Y2 + X2+2400..X3 Y2+3600..Y4 + X2+5600..X3 Y4..Y4+12000 + X2+2400..X3 Y4+12000..Y6 name:吹抜け void:1
space /L2..L5/mall corridor X3..X8 Y2..Y2+3600 name:モール lease.category:common floor:石張り
space /L2..L5/north backyard X4..X7 Y5..Y6 name:北側サービス lease.category:common
space /L2..L5/bohW backyard X3..X4 Y4-3200..Y6 name:バックヤード西 lease.category:common
space /L2..L5/bohE backyard X7..X8 Y4-3200..Y6 name:バックヤード東 lease.category:common
space /L2..L4/es escalator X2+2400..X2+5600 Y4..Y4+12000 name:エスカレーター lease.category:common escalator:N
space /L5/es corridor X2+2400..X2+5600 Y4..Y4+12000 name:エスカレーター上部 lease.category:common

# ---- 西列: 吹抜けに面する区画 (南→北に5区画) ----
band Y X1..X2 Y1..Y6
  space /L2..L5/w01 shop w:8000 name:西区画01 lease.category:rentable
  space /L2..L5/w02 shop w:8000 name:西区画02 lease.category:rentable
  space /L2..L5/w03 shop w:8000 name:西区画03 lease.category:rentable
  space /L2..L5/w04 shop w:8000 name:西区画04 lease.category:rentable
  space /L2..L5/w05 shop w:rest name:西区画05 lease.category:rentable

# ---- モールの南列 (西→東に5区画) ----
band X X3..X8 Y1..Y2
  space /L2..L5/s01 shop w:8000 name:南区画01 lease.category:rentable
  space /L2..L5/s02 shop w:8000 name:南区画02 lease.category:rentable
  space /L2..L5/s03 shop w:8000 name:南区画03 lease.category:rentable
  space /L2..L5/s04 shop w:8000 name:南区画04 lease.category:rentable
  space /L2..L5/s05 shop w:rest name:南区画05 lease.category:rentable

# ---- モールの北列 (西→東に5区画) ----
band X X3..X8 Y2+3600..Y4-3200
  space /L2..L5/n01 shop w:8000 name:北区画01 lease.category:rentable
  space /L2..L5/n02 shop w:6000 name:北区画02 lease.category:rentable
  space /L2..L5/ncorr corridor w:4000 name:北連絡通路 lease.category:common floor:石張り   # モールとコアを結ぶ — 避難は他人の区画を通らない
  space /L2..L5/n03 shop w:8000 name:北区画03 lease.category:rentable
  space /L2..L5/n04 shop w:8000 name:北区画04 lease.category:rentable
  space /L2..L5/n05 shop w:rest name:北区画05 lease.category:rentable

# ---- 区画はモールに面して開く (自動ドア) ----
boundary /L2..L5/s01 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/s02 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/s03 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/s04 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/s05 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/n01 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/n02 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/n03 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/n04 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/n05 /L2..L5/mall t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/w01 /L2..L5/wgal t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/w02 /L2..L5/wgal t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/w03 /L2..L5/wgal t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/w04 /L2..L5/wgal t:120 spec:店舗サッシ
  door AD1
boundary /L2..L5/w05 /L2..L5/wgal t:120 spec:店舗サッシ
  door AD1

# ---- 吹抜けの縁は手すり (遮蔽しない物 — air:1)、モールは吹抜けへ抜ける ----
boundary /L2..L5/mall /L2..L5/wgal type:open
boundary /L2..L5/wgal /L2..L5/atrium t:60 spec:手すり air:1 h:1100
boundary /L2..L5/s01 /L2..L5/atrium t:120 spec:店舗サッシ
boundary /L2..L5/n01 /L2..L5/atrium t:120 spec:店舗サッシ
boundary /L2..L5/bohW /L2..L5/atrium t:200 spec:RC

# ---- 所与の斜め: 隣地境界なりの隅切り ----
boundary /L2..L5/w05 /out t:300 spec:カーテンウォール
  line X1,Y5+2000 X2,Y6
boundary /L2..L5/bohE /out t:300 spec:カーテンウォール
  line X7+4000,Y6 X8,Y5+2000

# ---- コアとバックヤード ----
boundary /L2..L5/ncorr /L2..L5/hall type:open
boundary /L2..L5/ncorr /L2..L5/mall type:open
boundary /L2..L5/bohW /L2..L5/hall t:200 spec:RC
  door FD2 name:バックヤード扉
boundary /L2..L5/bohE /L2..L5/hall t:200 spec:RC
  door FD2 name:バックヤード扉2
boundary /L2..L5/wgal /L2..L5/es type:open
boundary /L2..L5/north /L2..L5/bohW t:200 spec:RC
  door w:1200
boundary /L2..L5/north /L2..L5/bohE t:200 spec:RC
  door w:1200

# ---- 外周 ----
boundary /L2..L5/w01 /out edge:W t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/w02 /out edge:W t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/w03 /out edge:W t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/w04 /out edge:W t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/w05 /out edge:W t:300 spec:カーテンウォール
boundary /L2..L5/w01 /out edge:S t:300 spec:カーテンウォール
boundary /L2..L5/wgal /out edge:S t:300 spec:カーテンウォール
boundary /L2..L5/wgal /out edge:N t:300 spec:カーテンウォール
boundary /L2..L5/atrium /out edge:S t:300 spec:カーテンウォール
boundary /L2..L5/atrium /out edge:N t:300 spec:カーテンウォール
boundary /L2..L5/s01 /out edge:S t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/s02 /out edge:S t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/s03 /out edge:S t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/s04 /out edge:S t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/s05 /out edge:S t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/s05 /out edge:E t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/n05 /out edge:E t:300 spec:カーテンウォール
  window CW1
boundary /L2..L5/mall /out edge:E t:300 spec:カーテンウォール
boundary /L2..L5/bohE /out edge:E t:300 spec:カーテンウォール
boundary /L2..L5/bohW /out edge:N t:300 spec:カーテンウォール
boundary /L2..L5/bohE /out edge:N t:300 spec:カーテンウォール
boundary /L2..L5/north /out edge:N t:300 spec:カーテンウォール
