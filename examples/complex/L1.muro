# 1階 — 基壇の地表面。テナント区画・モール・南北をつなぐ貫通通路。
#
# **斜めは所与の線 (隣地境界) にしか無い。**基壇の北西と北東の隅切りは敷地なりに
# 外形を切ったもので、`line` で引かれている (ADR-0022)。設計された斜めは書いていない —
# 規則正しい区画の並ぶモールに斜めの通路を通すのは、記法ができるからやっただけの
# 判断であって、設計判断ではなかった。**線の本数は設計判断の数と一致すべきである。**
# 斜めを設計として引く記法そのものは残っていて、test/runs.test.ts が保証している。
#
# 区画は帯 (band) が割る (ADR-0019)。幅の数字を書き換えれば隣の位置は自動で動く。

space /L1/ramp parking X1..X2 Y1..Y1+7000 name:車路出口 use:parking
space /L1/atrium corridor X2..X2+2400 Y1..Y6 + X2+5600..X3 Y1..Y6 + X2+2400..X2+5600 Y1..Y4 + X2+2400..X2+5600 Y4+12000..Y6 name:貫通通路 use:common floor:石張り
space /L1/mall corridor X3..X8 Y2..Y2+3600 name:モール use:common floor:石張り
space /L1/bohW backyard X3..X4 Y4-3200..Y6 name:バックヤード西 use:common
space /L1/bohE backyard X7..X8 Y4-3200..Y6 name:荷捌き・搬入 use:common
space /L1/north backyard X4..X7 Y5..Y6 name:北側サービス use:common
# エスカレーターは吹抜けの中に立つ — 客はモールと貫通通路から乗る。
# バックヤードの奥に置くと、平面としては閉じていても客は辿り着けない
space /L1/es escalator X2+2400..X2+5600 Y4..Y4+12000 name:エスカレーター use:common escalator:N

band Y X1..X2 Y1+7000..Y6
  space /L1/w01 shop w:8000 name:西区画01 use:rentable
  space /L1/w02 shop w:8000 name:西区画02 use:rentable
  space /L1/w03 shop w:8000 name:西区画03 use:rentable
  space /L1/w04 shop w:rest name:西区画04 use:rentable

band X X3..X8 Y1..Y2
  space /L1/s01 shop w:8000 name:南区画01 use:rentable
  space /L1/s02 shop w:8000 name:南区画02 use:rentable
  space /L1/s03 shop w:8000 name:南区画03 use:rentable
  space /L1/s04 shop w:8000 name:南区画04 use:rentable
  space /L1/s05 shop w:rest name:南区画05 use:rentable

band X X3..X8 Y2+3600..Y4-3200
  space /L1/n01 shop w:8000 name:北区画01 use:rentable
  space /L1/n02 shop w:6000 name:北区画02 use:rentable
  space /L1/ncorr corridor w:4000 name:北連絡通路 use:common floor:石張り   # モールとコアを結ぶ — 避難は他人の区画を通らない
  space /L1/n03 shop w:8000 name:北区画03 use:rentable
  space /L1/n04 shop w:8000 name:北区画04 use:rentable
  space /L1/n05 shop w:rest name:北区画05 use:rentable

# ---- 所与の斜め: 隣地境界なりの隅切り ----
boundary /L1/w04 /out t:300 spec:カーテンウォール
  line X1,Y5+2000 X2,Y6
boundary /L1/bohE /out t:300 spec:カーテンウォール
  line X7+4000,Y6 X8,Y5+2000

# ---- 区画はモールと貫通通路に面して開く ----
boundary /L1/s01 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/s02 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/s03 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/s04 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/s05 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/n01 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/n02 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/n03 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/n04 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/n05 /L1/mall t:120 spec:店舗サッシ
  door AD1
boundary /L1/w01 /L1/atrium t:120 spec:店舗サッシ
  door AD1
boundary /L1/w02 /L1/atrium t:120 spec:店舗サッシ
  door AD1
boundary /L1/w03 /L1/atrium t:120 spec:店舗サッシ
  door AD1
boundary /L1/w04 /L1/atrium t:120 spec:店舗サッシ
  door AD1
boundary /L1/atrium /L1/mall type:open
boundary /L1/atrium /L1/s01 t:200 spec:店舗サッシ
  door AD1
boundary /L1/atrium /L1/n01 t:200 spec:店舗サッシ
  door AD1 at:0.28
boundary /L1/atrium /L1/bohW t:250 spec:RC
boundary /L1/ramp /L1/atrium t:250 spec:RC

# ---- コアとサービス ----
boundary /L1/ncorr /L1/hall type:open
boundary /L1/ncorr /L1/mall type:open
boundary /L1/bohW /L1/hall t:200 spec:RC
  door FD2 name:バックヤード扉
boundary /L1/bohE /L1/hall t:200 spec:RC
  door FD2 name:荷捌きから
boundary /L1/atrium /L1/es type:open
boundary /L1/north /L1/bohW t:200 spec:RC
  door w:1200
boundary /L1/north /L1/bohE t:200 spec:RC
  door w:1200

# ---- 外周 ----
boundary /L1/atrium /site/walk edge:S t:300 spec:カーテンウォール
  door AD1 name:南側通り抜け口
boundary /L1/atrium /out edge:N t:300 spec:カーテンウォール
  door AD1 name:北側通り抜け口
boundary /L1/ramp /site/walk edge:S t:300 spec:RC
boundary /L1/ramp /site/plaza edge:W t:300 spec:RC
  door VG1 name:車路出入口   # 2層の駐車場はここからしか出入りできない
boundary /L1/w01 /site/plaza edge:W t:300 spec:カーテンウォール
  door AD1
boundary /L1/w02 /site/plaza edge:W t:300 spec:カーテンウォール
  door AD1
boundary /L1/w03 /site/plaza edge:W t:300 spec:カーテンウォール
  door AD1
boundary /L1/w04 /site/plaza edge:W t:300 spec:カーテンウォール
boundary /L1/s01 /site/walk edge:S t:300 spec:カーテンウォール
  door AD1
boundary /L1/s02 /site/walk edge:S t:300 spec:カーテンウォール
  door AD1
boundary /L1/s03 /site/walk edge:S t:300 spec:カーテンウォール
  door AD1
boundary /L1/s04 /site/walk edge:S t:300 spec:カーテンウォール
  door AD1
boundary /L1/s05 /site/walk edge:S t:300 spec:カーテンウォール
  door AD1
boundary /L1/s05 /site/east edge:E t:300 spec:カーテンウォール
  door AD1 name:東側入口
boundary /L1/n05 /site/east edge:E t:300 spec:カーテンウォール
boundary /L1/mall /site/east edge:E t:300 spec:カーテンウォール
  door AD1 name:東側モール入口
boundary /L1/bohE /site/east edge:E t:300 spec:RC
  door GD1 name:荷捌き入口
boundary /L1/bohW /out edge:N t:300 spec:RC
boundary /L1/bohE /out edge:N t:300 spec:RC
boundary /L1/north /out edge:N t:300 spec:RC
