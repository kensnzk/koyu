muro 1.5
name Stair and railing symbols
unit mm

grid X 0 3000 7000
grid Y 0 2700 5400

level L1 0 h:2700 slab:300
level L2 3000 h:2700 slab:300
level L3 6000 h:2700 slab:300

space /L1..L2/st stair X1..X2 Y1..Y3 stair:N form:return name:Stair
space /L3/st stair X1..X2 Y1..Y3 name:Stair
space /L1..L3/hall hall X2..X3 Y1..Y2 name:Landing
space /L1..L3/void void X2..X3 Y2..Y3 void:1 name:Void

space /out exterior outside:1 name:Outside

boundary /L1..L3/st /L1..L3/hall t:150
  door w:900 style:hinged
boundary /L1..L3/st /L1..L3/void t:150
boundary /L1..L3/hall /L1..L3/void t:60 air:1 h:1100 spec:railing

boundary /L1..L3/st /out edge:W t:150
boundary /L1..L3/st /out edge:S t:150
boundary /L1..L3/st /out edge:N t:150
boundary /L1..L3/hall /out edge:S t:150
boundary /L1..L3/hall /out edge:E t:150
boundary /L1..L3/void /out edge:N t:150
boundary /L1..L3/void /out edge:E t:150

stack st L1..L3 type:stair
