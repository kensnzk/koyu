muro 1.5
name Door symbols
unit mm

grid X 0 3200 6400 9600 12800 16000 19200 22400 25600
grid Y 0 4800 6200 11000
level L1 0 h:2800 slab:200

space /L1/hinged room X1..X2 Y1..Y2 name:Hinged
space /L1/double room X2..X3 Y1..Y2 name:Double
space /L1/unequal room X3..X4 Y1..Y2 name:Unequal
space /L1/single-slide room X4..X5 Y1..Y2 name:Single-slide
space /L1/double-slide room X5..X6 Y1..Y2 name:Double-slide
space /L1/bypass room X6..X7 Y1..Y2 name:Bypass
space /L1/auto-single room X1..X2 Y3..Y4 name:Auto-single
space /L1/auto-double room X2..X3 Y3..Y4 name:Auto-double
space /L1/entrance room X3..X4 Y3..Y4 name:Entrance
space /L1/swing-gate room X4..X5 Y3..Y4 name:Swing-gate
space /L1/double-gate room X5..X6 Y3..Y4 name:Double-gate
space /L1/slide-gate room X6..X7 Y3..Y4 name:Slide-gate
space /L1/rolling-shutter room X7..X8 Y3..Y4 name:Rolling-shutter
space /L1/overhead room X8..X9 Y3..Y4 name:Overhead
space /outside exterior outside:1 name:Outside

boundary /L1/hinged /outside t:200 edge:y+
  door w:1000 at:0.5 hinge:x- swing:a style:hinged name:hinged
boundary /L1/double /outside t:200 edge:y+
  door w:1800 at:0.5 hinge:x- swing:a style:hinged-double name:double
boundary /L1/unequal /outside t:200 edge:y+
  door w:1800 at:0.5 hinge:x- swing:a style:hinged-unequal name:unequal
boundary /L1/single-slide /outside t:200 edge:y+
  door w:1400 at:0.5 hinge:x- swing:a style:sliding name:single-slide
boundary /L1/double-slide /outside t:200 edge:y+
  door w:1800 at:0.5 hinge:x- swing:a style:sliding-double name:double-slide
boundary /L1/bypass /outside t:200 edge:y+
  door w:1800 at:0.5 hinge:x- swing:a style:sliding-bypass name:bypass
boundary /L1/auto-single /outside t:200 edge:y+
  door w:1400 at:0.5 hinge:x- swing:a style:auto-single name:auto-single
boundary /L1/auto-double /outside t:200 edge:y+
  door w:1800 at:0.5 hinge:x- swing:a style:auto-double name:auto-double
boundary /L1/entrance /outside t:200 edge:y+
  door w:1800 at:0.5 hinge:x- swing:a style:entrance name:entrance
boundary /L1/swing-gate /outside t:120 air:1 h:1200 edge:y+
  door w:1400 h:1200 at:0.5 hinge:x- swing:a style:gate-hinged name:swing-gate
boundary /L1/double-gate /outside t:120 air:1 h:1200 edge:y+
  door w:1800 h:1200 at:0.5 hinge:x- swing:a style:gate-hinged-double name:double-gate
boundary /L1/slide-gate /outside t:120 air:1 h:1200 edge:y+
  door w:1800 h:1200 at:0.5 hinge:x- swing:a style:gate-sliding name:slide-gate
boundary /L1/rolling-shutter /outside t:200 edge:y+
  door w:1800 h:2400 at:0.5 hinge:x- swing:a style:rolling-shutter name:rolling-shutter
boundary /L1/overhead /outside t:200 edge:y+
  door w:1800 h:2400 at:0.5 hinge:x- swing:a style:overhead name:overhead

