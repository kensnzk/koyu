band X X1..X2 Y1..Y2
  space /L2/meeting room w:3600 name:Meeting
  space /L2/office room w:rest name:"Office floor"

band X X1..X2 Y2..Y3
  space /L2/corr corridor w:rest name:Corridor
  space /L2/core stair w:3600 name:"Stair and shaft"

boundary /L2/office /L2/corr t:120
  door w:900
boundary /L2/meeting /L2/corr t:120
  door w:900
boundary /L2/corr /L2/core t:150
  door w:900
boundary /L1/core /L2/core type:stair
boundary /L2/meeting /out t:200 spec:RC
boundary /L2/office /out t:200 spec:RC
boundary /L2/corr /out t:200 spec:RC
boundary /L2/core /out t:200 spec:RC
